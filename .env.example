# PROVIDER : groq or ollama
TEXT_PROVIDER=ollama # groq or ollama
VISION_PROVIDER=ollama # groq or ollama

GROQ_API_KEY=your_groq_api_key
OLLAMA_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0
LLM_MAX_RETRIES=5

# MODELS
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

LOCAL_TEXT_MODEL=qwen2.5:7b
LOCAL_VISION_MODEL=minicpm-v

EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG
RAG_DB=qdrant # qdrant or chroma or faiss
RAG_MODE=hybrid # hybrid or vector or keyword

QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=cnes_km_agent

CHROMA_PATH=./chroma_db

#TOOLS
SEARX_HOST=http://localhost:8080

DATA_PATH=data
